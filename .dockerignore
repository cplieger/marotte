.git
.github
.refactor
node_modules
static-src/node_modules
*.md
LICENSE
# The license files the image ships under /usr/share/licenses, and the
# collector that builds that tree: admitted back past the excludes above.
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
!scripts/collect-licenses.sh
# Local-dev Go workspace: its `replace` directives point at sibling
# working-tree checkouts (../webhttp, ../web-terminal-engine) that don't
# exist in the build context, so a stray go.work would break the
# in-container `go build`. CI builds from a fresh clone where these are
# gitignored; excluding them here protects a local `docker build` too.
go.work
go.work.sum
