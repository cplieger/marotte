{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "*.ts",
    "*.d.ts",
    "handlers/*.ts",
    "wire/*.ts",
    "actions/*.ts",
    "lib/**/*.ts",
    "audit/*.ts",
    "legacy-ui/**/*.ts",
    "scripts/*.ts",
    "**/__test-helpers__/**/*.ts",
    "__mocks__/*.ts",
    "**/*.test.ts"
  ],
  "exclude": ["vitest.config.ts"]
}
