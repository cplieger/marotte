{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node", "vitest/globals"],
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  // The base config excludes the vitest configs, so this one resets exclude;
  // the test files are tsconfig.test.json's.
  "include": ["vitest.config.ts", "vitest.stryker.config.ts"],
  "exclude": []
}
