{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app.ts",
    "sw.ts",
    "vitest.stryker.config.ts",
    "__test-helpers__/stryker-fc-setup.ts",
    "sse-worker.ts",
    "prepaint.ts",
    "eslint.config.base.mjs",
    "perf/view.mjs",
    "**/*.test.ts",
    "**/*.node.test.ts",
    "**/*.property.test.ts"
  ],
  "project": ["**/*.ts", "perf/*.mjs", "!**/*.d.ts", "!node_modules/**"],
  "ignore": ["wire/*.gen.ts"],
  "ignoreDependencies": ["stylelint", "stylelint-config-standard"],
  "ignoreBinaries": ["go"],
  "ignoreMembers": [
    "active",
    "element",
    "finalize",
    "getText",
    "isThinking",
    "loadList",
    "loadMessages",
    "removeChat",
    "setActive",
    "setCurrentMode",
    "setThinking",
    "setWorkingLabel",
    "subscribe",
    "upsertHeader"
  ],
  "treatConfigHintsAsErrors": true,
  "rules": { "cycles": "error" },
  "includeEntryExports": true,
  "tags": ["-@knipignore"],
  "typescript": {
    "config": ["tsconfig.json", "tsconfig.sw.json", "tsconfig.node.json"]
  },
  "ignoreIssues": {
    "actions/index.ts": ["exports", "types"],
    "icons.ts": ["duplicates"],
    "vitest.stryker.config.ts": ["exports"],
    "types.ts": ["types"]
  }
}
