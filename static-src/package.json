{
  "name": "marotte-web",
  "private": true,
  "type": "module",
  "sseFixture": "..",
  "sseFixtureTags": "marotte_test",
  "cplieger": {
    "vitestShards": 2
  },
  "scripts": {
    "pretest": "rm -rf node_modules/.vite",
    "test": "vitest --run --reporter=default --reporter=json --outputFile.json=.vitest/duration-report.json",
    "posttest": "node scripts/check-suite-duration.ts .vitest/duration-report.json",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "typecheck": "tsc -project tsconfig.json && tsc -project tsconfig.sw.json && tsc -project tsconfig.node.json",
    "typecheck:tests": "tsc -project tsconfig.test.json",
    "typecheck:build": "tsc -project tsconfig.build.json",
    "typecheck:sw": "tsc -project tsconfig.sw.json",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:knip": "knip",
    "capture:closed-row": "node scripts/capture-closed-row.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "knip": "6.44.2",
    "msw": "3.0.4",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@cplieger/keyenc": "1.2.0",
    "@cplieger/reactive": "2.4.0",
    "@cplieger/sse": "2.2.0",
    "@cplieger/ui": "1.3.0-dev.24",
    "@cplieger/web-terminal-engine": "6.5.0-dev.9",
    "@cplieger/web-terminal-ui": "9.0.0-dev.3",
    "pele": "1.13.0"
  },
  "overrides": {
    "qs": "^6.15.2",
    "minimatch": "^11.0.1"
  }
}
