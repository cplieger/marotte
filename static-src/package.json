{
  "name": "marotte-web",
  "private": true,
  "type": "module",
  "sseFixture": ".",
  "sseFixtureTags": "marotte_test",
  "scripts": {
    "pretest": "rm -rf node_modules/.vite",
    "test": "vitest --run --reporter=default --reporter=json --outputFile.json=.vitest/duration-report.json && node scripts/check-suite-duration.ts .vitest/duration-report.json",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "typecheck": "tsc -project tsconfig.json && tsc -project tsconfig.sw.json && tsc -project tsconfig.node.json",
    "typecheck:tests": "tsc -project tsconfig.test.json",
    "typecheck:build": "tsc -project tsconfig.build.json",
    "typecheck:sw": "tsc -project tsconfig.sw.json",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser": "5.0.4",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "knip": "6.41.0",
    "msw": "3.0.3",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@cplieger/actions": "3.3.0-dev.1",
    "@cplieger/fetch": "2.2.2",
    "@cplieger/keyenc": "1.0.11",
    "@cplieger/reactive": "2.2.0",
    "@cplieger/sse": "1.3.0-dev.1",
    "@cplieger/ui-primitives": "3.3.0-dev.1",
    "@cplieger/web-terminal-engine": "6.4.0-dev.4",
    "@cplieger/web-terminal-ui": "8.6.0-dev.6",
    "pele": "1.4.0"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
