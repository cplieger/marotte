   {
    "name": "autoresearch",
    "description": "Repeatedly proposes and applies one experiment at a time, runs the benchmark, and keeps changes only when they beat the current best result.",
    "source": "bundled://autoresearch",
    "inputs": {
     "benchmark_path": "string",
     "research_directions": "string"
    },
    "plan": [
     {
      "nodeId": "experiments",
      "type": "repeat",
      "steps": [
       {
        "nodeId": "experiment",
        "type": "step",
        "agentName": "wf-auto-researcher"
       }
      ],
      "maxIterations": 1000,
      "onMaxIterations": "pause"
     }
    ],
    "builtIn": true,
    "_meta": {
     "kiro": {
      "resource": {
       "resourceType": "workflow",
       "source": {
        "origin": "bundled"
       }
      }
     }
    }
   },
   {
    "name": "feature-pipeline",
    "description": "Full feature pipeline in the given workdir: requirements, reviewed design loop, plan, implement-and-review loop with two-model review, fail-closed validation gate. Heavy; for hard multi-file tasks.",
    "source": "bundled://feature-pipeline",
    "inputs": {
     "task": "prompt",
     "workdir": "string"
    },
    "plan": [
     {
      "nodeId": "setup",
      "type": "step",
      "agentName": "wf-coder",
      "effortLevel": "low"
     },
     {
      "nodeId": "requirements",
      "type": "step",
      "agentName": "wf-design"
     },
     {
      "nodeId": "design-loop",
      "type": "repeat",
      "steps": [
       {
        "nodeId": "design-draft",
        "type": "step",
        "agentName": "wf-design"
       },
       {
        "nodeId": "design-review",
        "type": "step",
        "agentName": "wf-design-reviewer"
       }
      ],
      "maxIterations": 3,
      "onMaxIterations": "abort",
      "stopCondition": {
       "fileCheck": {
        "path": "{{setup.output}}/design-review.json",
        "jsonPath": "verdict",
        "value": "APPROVED"
       }
      }
     },
     {
      "nodeId": "plan",
      "type": "step",
      "agentName": "wf-planner",
      "effortLevel": "high"
     },
     {
      "nodeId": "code-loop",
      "type": "repeat",
      "steps": [
       {
        "nodeId": "implement",
        "type": "step",
        "agentName": "wf-coder"
       },
       {
        "nodeId": "code-reviews",
        "type": "parallel",
        "branches": [
         {
          "nodeId": "review-fable",
          "type": "step",
          "agentName": "semantic_reviewer",
          "modelId": "claude-fable-5",
          "effortLevel": "xhigh"
         },
         {
          "nodeId": "review-gpt",
          "type": "step",
          "agentName": "semantic_reviewer",
          "modelId": "gpt-5.6-sol",
          "effortLevel": "xhigh"
         }
        ]
       },
       {
        "nodeId": "code-aggregate",
        "type": "step",
        "agentName": "wf-review-aggregator",
        "effortLevel": "high"
       }
      ],
      "maxIterations": 3,
      "onMaxIterations": "abort",
      "stopCondition": {
       "fileCheck": {
        "path": "{{setup.output}}/code-review.json",
        "jsonPath": "verdict",
        "value": "APPROVED"
       }
      }
     },
     {
      "nodeId": "validate-gate",
      "type": "repeat",
      "steps": [
       {
        "nodeId": "validate",
        "type": "step",
        "agentName": "wf-coder"
       }
      ],
      "maxIterations": 1,
      "onMaxIterations": "abort",
      "stopCondition": {
       "fileCheck": {
        "path": "{{setup.output}}/validation.json",
        "jsonPath": "verdict",
        "value": "PASS"
       }
      }
     }
    ],
    "builtIn": true,
    "_meta": {
     "kiro": {
      "resource": {
       "resourceType": "workflow",
       "source": {
        "origin": "bundled"
       }
      }
     }
    }
   },
   {
    "name": "goal",
    "description": "Iterative agent loop toward a single verifiable goal until self-verified complete or the iteration budget is exhausted; no external progress state, each iteration re-derives progress from the repo.",
    "source": "bundled://goal",
    "inputs": {
     "prompt": "prompt",
     "max_iterations": "string"
    },
    "plan": [
     {
      "nodeId": "goal-loop",
      "type": "repeat",
