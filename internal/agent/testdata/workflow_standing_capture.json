   {
    "name": "publish-pr",
    "description": "Opens a PR from a branch (reuses an existing open PR), then watches and responds to feedback until a terminal state. run_dir: required per-run artifact dir; repo_dir: target repo (optional).",
    "source": "bundled://publish-pr",
    "inputs": {
